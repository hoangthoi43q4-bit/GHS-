@page "/send"
@page "/"
@inject IDbContextFactory<GHSDbContext> DbFactory
@inject TcpConnectionPool TcpPool
@inject StringProcessor StringProcessor
@inject MaterialClassifier MaterialClassifier
@inject SelectMatPos SelectMatPos
@inject BufferMaterialService BufferService
@inject UploadHistoryService HistoryService
@inject IHubContext<LogHub> HubContext
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage SessionStorage
@implements IAsyncDisposable

<PageTitle>发送物料 — GHP HandShake Web</PageTitle>

<MudGrid>
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="1">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudTextField @ref="_scanFieldRef" @bind-Value="_scanInput" Label="物料标签 (Scan Label)"
                                  Variant="Variant.Outlined" Immediate="true"
                                  OnKeyUp="OnScanKeyUp" AdornmentColor="Color.Primary" />
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudSelect @bind-Value="_selectedLine" Label="线体"
                               Variant="Variant.Outlined" T="string"
                               SelectedValuesChanged="OnLineChanged">
                        @foreach (var l in _lineNames)
                        {
                            <MudSelectItem Value="@l">@l</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudSelect @bind-Value="_selectedProject" Label="项目"
                               Variant="Variant.Outlined" T="string"
                               SelectedValuesChanged="OnProjectChanged">
                        @foreach (var p in _filteredProjects)
                        {
                            var displayName = p.Contains(":") ? p.Split(':')[1] : p;
                            <MudSelectItem Value="@p">@displayName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudText Class="mt-2">
                        匹配设备: <strong>@_matchedEquipment</strong>
                    </MudText>
                </MudItem>
                <MudItem xs="6" md="1">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="SendMessageAsync" FullWidth="true">
                        发送
                    </MudButton>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                               OnClick="ViewCurrentMaterialsAsync" FullWidth="true">
                        查看当前料
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudItem>

    @if (_bufferMaterials != null)
    {
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="1">
                <div class="d-flex align-center mb-2">
                    <MudText Typo="Typo.h6">当前在料 (LoadMaterialBufferPreserve.xml)</MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Filled" Color="Color.Error" Class="mr-2"
                               StartIcon="@Icons.Material.Filled.RemoveShoppingCart"
                               Disabled="_unloadBusy"
                               OnClick="UnloadAllAsync">全部下料</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Close"
                               OnClick="CloseBufferMaterials">关闭</MudButton>
                </div>
                @if (!string.IsNullOrEmpty(_bufferError))
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-2">@_bufferError</MudAlert>
                }
                @if (_bufferMaterials.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">未读取到在料记录。</MudAlert>
                }
                else
                {
                    <MudTable Items="_bufferMaterials" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>站位</MudTh>
                            <MudTh>Pos</MudTh>
                            <MudTh>物料号</MudTh>
                            <MudTh>完整 Id</MudTh>
                            <MudTh>操作</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.EquipmentId</MudTd>
                            <MudTd>@context.Position</MudTd>
                            <MudTd>@context.MaterialNumber</MudTd>
                            <MudTd>@context.RawId</MudTd>
                            <MudTd>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                           Disabled="_unloadBusy"
                                           OnClick="@(() => UnloadOneAsync(context))">下料</MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudItem>
    }

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-4">物料状态面板</MudText>
            <MudDataGrid Items="@_materialStatuses" ReadOnly="true" Hover="true"
                         Striped="true" Dense="true" Height="calc(100vh - 260px)">
                <Columns>
                    <TemplateColumn Title="状态" CellClass="text-center">
                        <CellTemplate>
                            <MudIcon Icon="@GetStatusIcon(context.Item.UploadStatus)"
                                     Color="@GetStatusColor(context.Item.UploadStatus)" Size="Size.Small" />
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.TypeName" Title="Pos" />
                    <PropertyColumn Property="x => x.SubTypeName" Title="物料号" />
                    <PropertyColumn Property="x => x.MachineName" Title="设备" />
                    <PropertyColumn Property="x => x.UploadStatus" Title="状态" />
                </Columns>
            </MudDataGrid>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-4">实时通信日志</MudText>
            <MudPaper Class="pa-2" Style="height:calc(100vh - 260px);overflow-y:auto;background:#1E293B;color:#E2E8F0;font-family:monospace;font-size:13px;">
                @foreach (var log in _logs)
                {
                    <div style="padding:2px 0;border-bottom:1px solid #334155;">@log</div>
                }
            </MudPaper>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private string _scanInput = "";
    private string _selectedLine = "";
    private string _selectedProject = "";
    private string _selectedLineName = "";
    private string _matchedEquipment = "—";
    private MudTextField<string>? _scanFieldRef;
    private List<string> _lineNames = new();
    private List<string> _filteredProjects = new();
    private List<string> _logs = new();
    private List<ProjectMaterialStatusItem> _materialStatuses = new();
    private HubConnection? _hubConnection;
    private List<MaterialTypeInfo> _materialConfig = new();
    private List<BufferMaterialItem>? _bufferMaterials;
    private string _bufferError = "";

    private async Task ViewCurrentMaterialsAsync()
    {
        _bufferError = "";
        _bufferMaterials = null;

        var projectId = _selectedProject.Contains(":")
            ? int.Parse(_selectedProject.Split(':')[0])
            : -1;
        if (projectId <= 0)
        {
            _bufferMaterials = new List<BufferMaterialItem>();
            _bufferError = "请先选择线体和项目。";
            return;
        }

        try
        {
            var (items, error) = await BufferService.ReadByProjectAsync(projectId);
            _bufferMaterials = items;
            _bufferError = error;
        }
        catch (Exception ex)
        {
            _bufferMaterials = new List<BufferMaterialItem>();
            _bufferError = $"读取失败: {ex.Message}";
        }
    }

    private void CloseBufferMaterials()
    {
        _bufferMaterials = null;
        _bufferError = "";
    }

    private bool _unloadBusy;

    private async Task UnloadOneAsync(BufferMaterialItem item)
    {
        if (_unloadBusy) return;
        _unloadBusy = true;
        try
        {
            await SendUnloadAsync(item);
        }
        finally
        {
            _unloadBusy = false;
        }
    }

    private async Task UnloadAllAsync()
    {
        if (_unloadBusy || _bufferMaterials == null) return;
        _unloadBusy = true;
        try
        {
            // 逐条发送单料指令（tokens 固定 3，不合并多料）
            foreach (var item in _bufferMaterials.ToList())
            {
                await SendUnloadAsync(item);
            }
        }
        finally
        {
            _unloadBusy = false;
        }
    }

    private async Task SendUnloadAsync(BufferMaterialItem item)
    {
        // uid 用 XML 完整 Id（原样，不去零、不截 @）
        string command = StringProcessor.GenerateUnloadCommand(item.EquipmentId, item.Position, item.RawId);

        var result = await TcpPool.SendCommandAsync(
            item.EquipmentDbId, item.EquipmentId, item.ServerIp, item.ServerPort, command);

        await JS.InvokeVoidAsync("playBeep", result.IsAckSuccess ? "success" : "error");

        var entry = new UploadHistoryEntry
        {
            Timestamp = DateTime.UtcNow,
            LineName = _selectedLineName,
            ProjectName = _selectedProject.Contains(":")
                ? _selectedProject.Split(':')[1]
                : _selectedProject,
            SubTypeName = item.MaterialNumber,
            EquipmentId = item.EquipmentId,
            ScanContent = item.RawId,
            CommandSent = command,
            Response = result.Response,
            IsAckSuccess = result.IsAckSuccess
        };
        await HistoryService.AddEntryAsync(entry);
        AddLog($"[下料记录] 站位={item.EquipmentId}, Pos={item.Position}, 物料={item.MaterialNumber}, 结果={(result.IsAckSuccess ? "ACK成功" : "未成功")}");
    }
    private List<Equipment> _equipments = new();
    private Dictionary<int, string> _projectIdMap = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        await StartHubAsync();
    }

    private async Task LoadDataAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _lineNames = await db.Lines.Select(l => l.Name).OrderBy(l => l).ToListAsync();
        _equipments = await db.Equipments.OrderBy(e => e.EquipmentId).ToListAsync();
        _projectIdMap = await db.Projects.ToDictionaryAsync(p => p.Id, p => p.Name);

        _materialConfig = new();
        var types = await db.MaterialTypes.OrderBy(t => t.ProjectId).ThenBy(t => t.TypeName).ToListAsync();
        var eqMap = _equipments.ToDictionary(e => e.Id, e => e.EquipmentId);
        foreach (var t in types)
        {
            var subs = await db.MaterialSubTypes.Where(s => s.MaterialTypeId == t.Id).ToListAsync();
            _materialConfig.Add(new MaterialTypeInfo
            {
                ProjectId = t.ProjectId,
                TypeName = t.TypeName,
                SubTypes = subs.Select(s => new MaterialSubTypeInfo
                {
                    SubTypeName = s.SubTypeName,
                    AssociatedMachineName = eqMap.GetValueOrDefault(s.EquipmentId, ""),
                    EquipmentId = s.EquipmentId
                }).ToList()
            });
        }

        // 注意：此处不再默认选中第一个线体。
        // 选中值的确定统一放到 OnAfterRenderAsync：优先恢复上次选择，无存值时才取第一个。
        // 这样避免“先渲染第一个、再恢复”导致 MudSelect 把恢复值冲回第一个的竞态。
    }

    private bool _restored;
    private bool _restoring;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _restored) return;
        _restored = true;

        if (!_lineNames.Any()) return;

        _restoring = true;
        try
        {
        var savedLine = await SessionStorage.GetAsync<string>("ghs_selectedLine");
        var savedProject = await SessionStorage.GetAsync<string>("ghs_selectedProject");

        // 决定最终线体：有有效存值则用它，否则第一个
        var targetLine = (savedLine.Success && !string.IsNullOrEmpty(savedLine.Value) && _lineNames.Contains(savedLine.Value))
            ? savedLine.Value
            : _lineNames.First();

        _selectedLine = targetLine;
        await FilterProjectsByLineAsync();   // 会把项目默认设为第一个

        // 决定最终项目：有有效存值且仍在当前线体项目列表中则恢复
        if (savedProject.Success && !string.IsNullOrEmpty(savedProject.Value) && _filteredProjects.Contains(savedProject.Value))
        {
            _selectedProject = savedProject.Value;
            await RebuildStatusPanelAsync();
        }

        // 回写一次，保证存储与当前实际选中一致
        await SessionStorage.SetAsync("ghs_selectedLine", _selectedLine);
        await SessionStorage.SetAsync("ghs_selectedProject", _selectedProject);
        }
        finally
        {
            _restoring = false;
        }

        StateHasChanged();
    }

    private async Task FilterProjectsByLineAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedLine)) { _filteredProjects.Clear(); return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        var line = await db.Lines.FirstOrDefaultAsync(l => l.Name == _selectedLine);
        if (line == null) { _filteredProjects.Clear(); return; }
        _selectedLineName = line.Name;
        _filteredProjects = await db.Projects
        .Where(p => p.LineId == line.Id)
        .OrderBy(p => p.Name)
        .Select(p => p.Id + ":" + p.Name)   // "42:Nissan RA"
        .ToListAsync();

        if (_filteredProjects.Any())
            _selectedProject = _filteredProjects.First();
        else
            _selectedProject = "";
        await RebuildStatusPanelAsync();
    }

    private async Task OnLineChanged(IEnumerable<string> values)
    {
        if (_restoring) return;   // 恢复期间由 OnAfterRenderAsync 统一设值，忽略 MudSelect 回调，避免把恢复值冲回第一个
        _selectedLine = values.FirstOrDefault() ?? "";
        await SessionStorage.SetAsync("ghs_selectedLine", _selectedLine);
        await FilterProjectsByLineAsync();
        // 线体变更后项目会被重设为第一个，同步持久化
        await SessionStorage.SetAsync("ghs_selectedProject", _selectedProject);
    }

    private async Task OnProjectChanged(IEnumerable<string> values)
    {
        if (_restoring) return;   // 恢复期间忽略 MudSelect 回调
        _selectedProject = values.FirstOrDefault() ?? "";
        await SessionStorage.SetAsync("ghs_selectedProject", _selectedProject);
        await RebuildStatusPanelAsync();
    }

    private async Task StartHubAsync()
    {
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/loghub"))
            .Build();

        _hubConnection.On<string>("ReceiveLog", (message) =>
        {
            var line = $"[{DateTime.Now:HH:mm:ss}] {message}";
            _logs.Add(line);
            if (_logs.Count > 500) _logs.RemoveAt(0);
            InvokeAsync(StateHasChanged);
        });

        await _hubConnection.StartAsync();
    }

    private async Task OnScanKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            var message = _scanInput.Trim();
            _scanInput = "";
            await JS.InvokeVoidAsync("clearActiveInput");
            StateHasChanged();
            if (!string.IsNullOrEmpty(message))
                await ProcessMessageAsync(message);
        }
    }

    private async Task SendMessageAsync()
    {
        var message = _scanInput.Trim();
        _scanInput = "";
        StateHasChanged();
        if (string.IsNullOrEmpty(message)) return;
        await ProcessMessageAsync(message);
    }

    private async Task ProcessMessageAsync(string message)
    {
        async Task LogFailAsync(string reason, string? subType = null)
        {
            await HistoryService.AddEntryAsync(new UploadHistoryEntry
            {
                Timestamp = DateTime.UtcNow,
                LineName = _selectedLineName,
                ProjectName = _selectedProject.Contains(":") ? _selectedProject.Split(':')[1] : _selectedProject,
                SubTypeName = subType,
                ScanContent = message,
                Response = reason,
                IsAckSuccess = false
            });
        }

        var matLabel = StringProcessor.FindMaterial(message);
        if (string.IsNullOrEmpty(matLabel))
        {
            AddLog("发送内容中不包含物料信息！");
            await LogFailAsync("发送内容中不包含物料信息");
            return;
        }

        AddLog($"接收到物料号: {matLabel}。正在查找...");

        var matched = FindMaterial(matLabel);
        if (matched == null)
        {
            AddLog($"[错误] 配置中未找到物料 '{matLabel}'。");
            await LogFailAsync($"配置中未找到物料 '{matLabel}'", matLabel);
            return;
        }

        var equipment = _equipments.FirstOrDefault(e => e.EquipmentId == matched.AssociatedMachineName);
        if (equipment == null)
        {
            AddLog($"[错误] 物料关联的设备 '{matched.AssociatedMachineName}' 不存在。");
            await LogFailAsync($"物料关联的设备 '{matched.AssociatedMachineName}' 不存在", matLabel);

            return;
        }

        AddLog($"匹配成功! 目标设备: {equipment.EquipmentId} ({equipment.ServerIp}:{equipment.ServerPort})");
        _matchedEquipment = equipment.EquipmentId;
        SetMaterialStatus(matLabel, "等待ACK");

        //int matPos = SelectMatPos.GetMatPos(matLabel, _materialConfig);
        int matPos = int.TryParse(matched.TypeName, out var p) ? p : 0;

        string command = StringProcessor.GenerateLoadCommand(message, equipment.EquipmentId, matPos);

        var result = await TcpPool.SendCommandAsync(
            equipment.Id, equipment.EquipmentId, equipment.ServerIp, equipment.ServerPort, command);

        SetMaterialStatus(matLabel, result.IsAckSuccess ? "上传成功" : "上传未成功");
        await JS.InvokeVoidAsync("playBeep", result.IsAckSuccess ? "success" : "error");

        var entry = new UploadHistoryEntry
        {
            Timestamp = DateTime.UtcNow,
            LineName = _selectedLineName,
            ProjectName = _selectedProject.Contains(":")
                ? _selectedProject.Split(':')[1]
                : _selectedProject,
            TypeName = matched.TypeName,
            SubTypeName = matLabel,
            EquipmentId = equipment.EquipmentId,
            ScanContent = message,
            CommandSent = command,
            Response = result.Response,
            IsAckSuccess = result.IsAckSuccess
        };
        await HistoryService.AddEntryAsync(entry);
        AddLog($"[上料记录] 线体={_selectedLineName}, 项目={_selectedProject}, Pos={matched.TypeName}, 物料={matLabel}, 结果={(result.IsAckSuccess ? "ACK成功" : "未成功")}");
    }


    private MaterialSubTypeInfo? FindMaterial(string matLabel)
    {
        var projectId = _selectedProject.Contains(":")
            ? int.Parse(_selectedProject.Split(':')[0])
            : -1;

        foreach (var type in _materialConfig)
        {
            if (type.ProjectId != projectId) continue;
            var sub = type.SubTypes.FirstOrDefault(s =>
                s.SubTypeName.Equals(matLabel, StringComparison.OrdinalIgnoreCase) ||
                s.SubTypeName.Contains(matLabel, StringComparison.OrdinalIgnoreCase));
            if (sub != null)
            {
                sub.TypeName = type.TypeName;   // ← 新增:把当前项目下该记录的 Pos 带出去
                return sub;
            }
        }
        return null;
    }

    private async Task RebuildStatusPanelAsync()
    {
        _materialStatuses.Clear();
        if (string.IsNullOrWhiteSpace(_selectedProject)) return;

        // 从 "42:Nissan RA" 中取出 Id
        var projectId = _selectedProject.Contains(":")
            ? int.Parse(_selectedProject.Split(':')[0])
            : -1;

        await using var db = await DbFactory.CreateDbContextAsync();
        var project = await db.Projects.FirstOrDefaultAsync(p => p.Id == projectId);
        if (project == null) return;

        var subs = await db.MaterialSubTypes
            .Where(s => db.MaterialTypes.Any(t => t.Id == s.MaterialTypeId && t.ProjectId == project.Id))
            .Select(s => new ProjectMaterialStatusItem
            {
                TypeName = db.MaterialTypes.Where(t => t.Id == s.MaterialTypeId).Select(t => t.TypeName).FirstOrDefault() ?? "",
                SubTypeName = s.SubTypeName,
                MachineName = db.Equipments.Where(e => e.Id == s.EquipmentId).Select(e => e.EquipmentId).FirstOrDefault() ?? "",
                UploadStatus = "未上传"
            })
            .OrderBy(s => s.MachineName).ThenBy(s => s.TypeName).ThenBy(s => s.SubTypeName)
            .ToListAsync();

        _materialStatuses.AddRange(subs);
    }

    private void SetMaterialStatus(string matLabel, string status)
    {
        var target = _materialStatuses.FirstOrDefault(s =>
            s.SubTypeName.Contains(matLabel, StringComparison.OrdinalIgnoreCase));
        if (target != null)
            target.UploadStatus = status;
    }

    private void AddLog(string message)
    {
        var line = $"[{DateTime.Now:HH:mm:ss}] {message}";
        _logs.Add(line);
        if (_logs.Count > 500) _logs.RemoveAt(0);
    }

    private static Color GetStatusColor(string status) => status switch
    {
        var s when s.Contains("未成功") || s.Contains("失败") => Color.Error,   // 红 ❌
        var s when s.Contains("成功") => Color.Success,  // 绿 ✅
        var s when s.Contains("等待") => Color.Warning,  // 黄 ⏳
        _ => Color.Default   // 灰 ○
    };

    private static string GetStatusIcon(string status) => status switch
    {
        var s when s.Contains("未成功") || s.Contains("失败") => Icons.Material.Filled.Cancel,
        var s when s.Contains("成功") => Icons.Material.Filled.CheckCircle,
        var s when s.Contains("等待") => Icons.Material.Filled.HourglassTop,
        _ => Icons.Material.Filled.RadioButtonUnchecked
    };


    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
            await _hubConnection.DisposeAsync();
    }
}
