@page "/send"
@page "/"
@inject IDbContextFactory<GHSDbContext> DbFactory
@inject TcpConnectionPool TcpPool
@inject StringProcessor StringProcessor
@inject MaterialClassifier MaterialClassifier
@inject SelectMatPos SelectMatPos
@inject UploadHistoryService HistoryService
@inject IHubContext<LogHub> HubContext
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>发送物料 — GHP HandShake Web</PageTitle>

<MudGrid>
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="1">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_scanInput" Label="物料标签 (Scan Label)"
                                  Variant="Variant.Outlined" Immediate="true"
                                  OnKeyUp="OnScanKeyUp" AdornmentColor="Color.Primary" />
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudSelect @bind-Value="_selectedLine" Label="线体"
                               Variant="Variant.Outlined" T="string"
                               SelectedValuesChanged="OnLineChanged">
                        @foreach (var l in _lineNames)
                        {
                            <MudSelectItem Value="@l">@l</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudSelect @bind-Value="_selectedProject" Label="项目"
                               Variant="Variant.Outlined" T="string"
                               SelectedValuesChanged="OnProjectChanged">
                        @foreach (var p in _filteredProjects)
                        {
                            var displayName = p.Contains(":") ? p.Split(':')[1] : p;
                            <MudSelectItem Value="@p">@displayName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Class="mt-2">
                        匹配设备: <strong>@_matchedEquipment</strong>
                    </MudText>
                </MudItem>
                <MudItem xs="6" md="1">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="SendMessageAsync" FullWidth="true">
                        发送
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-4">物料状态面板</MudText>
            <MudDataGrid Items="@_materialStatuses" ReadOnly="true" Hover="true"
                         Striped="true" Dense="true" Height="400px">
                <Columns>
                    <TemplateColumn Title="状态" CellClass="text-center">
                        <CellTemplate>
                            <MudIcon Icon="@GetStatusIcon(context.Item.UploadStatus)"
                                     Color="@GetStatusColor(context.Item.UploadStatus)" Size="Size.Small" />
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.TypeName" Title="Pos" />
                    <PropertyColumn Property="x => x.SubTypeName" Title="物料号" />
                    <PropertyColumn Property="x => x.MachineName" Title="设备" />
                    <PropertyColumn Property="x => x.UploadStatus" Title="状态" />
                </Columns>
            </MudDataGrid>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-4">实时通信日志</MudText>
            <MudPaper Class="pa-2" Style="height:400px;overflow-y:auto;background:#1E293B;color:#E2E8F0;font-family:monospace;font-size:13px;">
                @foreach (var log in _logs)
                {
                    <div style="padding:2px 0;border-bottom:1px solid #334155;">@log</div>
                }
            </MudPaper>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private string _scanInput = "";
    private string _selectedLine = "";
    private string _selectedProject = "";
    private string _selectedLineName = "";
    private string _matchedEquipment = "—";
    private List<string> _lineNames = new();
    private List<string> _filteredProjects = new();
    private List<string> _logs = new();
    private List<ProjectMaterialStatusItem> _materialStatuses = new();
    private HubConnection? _hubConnection;
    private List<MaterialTypeInfo> _materialConfig = new();
    private List<Equipment> _equipments = new();
    private Dictionary<int, string> _projectIdMap = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        await StartHubAsync();
    }

    private async Task LoadDataAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _lineNames = await db.Lines.Select(l => l.Name).OrderBy(l => l).ToListAsync();
        _equipments = await db.Equipments.OrderBy(e => e.EquipmentId).ToListAsync();
        _projectIdMap = await db.Projects.ToDictionaryAsync(p => p.Id, p => p.Name);

        _materialConfig = new();
        var types = await db.MaterialTypes.OrderBy(t => t.ProjectId).ThenBy(t => t.TypeName).ToListAsync();
        var eqMap = _equipments.ToDictionary(e => e.Id, e => e.EquipmentId);
        foreach (var t in types)
        {
            var subs = await db.MaterialSubTypes.Where(s => s.MaterialTypeId == t.Id).ToListAsync();
            _materialConfig.Add(new MaterialTypeInfo
            {
                TypeName = t.TypeName,
                SubTypes = subs.Select(s => new MaterialSubTypeInfo
                {
                    SubTypeName = s.SubTypeName,
                    AssociatedMachineName = eqMap.GetValueOrDefault(s.EquipmentId, ""),
                    EquipmentId = s.EquipmentId
                }).ToList()
            });
        }

        if (_lineNames.Any())
        {
            _selectedLine = _lineNames.First();
            await FilterProjectsByLineAsync();
        }
    }

    private async Task FilterProjectsByLineAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedLine)) { _filteredProjects.Clear(); return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        var line = await db.Lines.FirstOrDefaultAsync(l => l.Name == _selectedLine);
        if (line == null) { _filteredProjects.Clear(); return; }
        _selectedLineName = line.Name;
        _filteredProjects = await db.Projects
        .Where(p => p.LineId == line.Id)
        .OrderBy(p => p.Name)
        .Select(p => p.Id + ":" + p.Name)   // "42:Nissan RA"
        .ToListAsync();

        if (_filteredProjects.Any())
            _selectedProject = _filteredProjects.First();
        else
            _selectedProject = "";
        await RebuildStatusPanelAsync();
    }

    private async Task OnLineChanged(IEnumerable<string> values)
    {
        _selectedLine = values.FirstOrDefault() ?? "";
        await FilterProjectsByLineAsync();
    }

    private async Task OnProjectChanged(IEnumerable<string> values)
    {
        _selectedProject = values.FirstOrDefault() ?? "";
        await RebuildStatusPanelAsync();
    }

    private async Task StartHubAsync()
    {
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/loghub"))
            .Build();

        _hubConnection.On<string>("ReceiveLog", (message) =>
        {
            var line = $"[{DateTime.Now:HH:mm:ss}] {message}";
            _logs.Add(line);
            if (_logs.Count > 500) _logs.RemoveAt(0);
            InvokeAsync(StateHasChanged);
        });

        await _hubConnection.StartAsync();
    }

    private async Task OnScanKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SendMessageAsync();
    }

    private async Task SendMessageAsync()
    {
        var message = _scanInput.Trim();
        if (string.IsNullOrEmpty(message)) return;

        var matLabel = StringProcessor.FindMaterial(message);
        if (string.IsNullOrEmpty(matLabel))
        {
            AddLog("发送内容中不包含物料信息！");
            return;
        }

        AddLog($"接收到物料号: {matLabel}。正在查找...");

        var matched = FindMaterial(matLabel);
        if (matched == null)
        {
            AddLog($"[错误] 配置中未找到物料 '{matLabel}'。");
            return;
        }

        var equipment = _equipments.FirstOrDefault(e => e.EquipmentId == matched.AssociatedMachineName);
        if (equipment == null)
        {
            AddLog($"[错误] 物料关联的设备 '{matched.AssociatedMachineName}' 不存在。");
            return;
        }

        AddLog($"匹配成功! 目标设备: {equipment.EquipmentId} ({equipment.ServerIp}:{equipment.ServerPort})");
        _matchedEquipment = equipment.EquipmentId;
        SetMaterialStatus(matLabel, "等待ACK");

        int matPos = SelectMatPos.GetMatPos(matLabel, _materialConfig);
        string command = StringProcessor.GenerateLoadCommand(message, equipment.EquipmentId, matPos);

        var result = await TcpPool.SendCommandAsync(
            equipment.Id, equipment.EquipmentId, equipment.ServerIp, equipment.ServerPort, command);

        SetMaterialStatus(matLabel, result.IsAckSuccess ? "上传成功" : "上传未成功");

        var entry = new UploadHistoryEntry
        {
            Timestamp = DateTime.UtcNow,
            LineName = _selectedLineName,
            ProjectName = _selectedProject.Contains(":")
                ? _selectedProject.Split(':')[1]
                : _selectedProject,
            TypeName = matched.TypeName,
            SubTypeName = matLabel,
            EquipmentId = equipment.EquipmentId,
            ScanContent = message,
            CommandSent = command,
            Response = result.Response,
            IsAckSuccess = result.IsAckSuccess
        };
        await HistoryService.AddEntryAsync(entry);
        AddLog($"[上料记录] 线体={_selectedLineName}, 项目={_selectedProject}, Pos={matched.TypeName}, 物料={matLabel}, 结果={(result.IsAckSuccess ? "ACK成功" : "未成功")}");

        _scanInput = "";
    }

    private MaterialSubTypeInfo? FindMaterial(string matLabel)
    {
        foreach (var type in _materialConfig)
        {
            var sub = type.SubTypes.FirstOrDefault(s => s.SubTypeName.Contains(matLabel));
            if (sub != null) return sub;
        }
        return null;
    }

    private async Task RebuildStatusPanelAsync()
    {
        _materialStatuses.Clear();
        if (string.IsNullOrWhiteSpace(_selectedProject)) return;

        // 从 "42:Nissan RA" 中取出 Id
        var projectId = _selectedProject.Contains(":")
            ? int.Parse(_selectedProject.Split(':')[0])
            : -1;

        await using var db = await DbFactory.CreateDbContextAsync();
        var project = await db.Projects.FirstOrDefaultAsync(p => p.Id == projectId);
        if (project == null) return;

        var subs = await db.MaterialSubTypes
            .Where(s => db.MaterialTypes.Any(t => t.Id == s.MaterialTypeId && t.ProjectId == project.Id))
            .Select(s => new ProjectMaterialStatusItem
            {
                TypeName = db.MaterialTypes.Where(t => t.Id == s.MaterialTypeId).Select(t => t.TypeName).FirstOrDefault() ?? "",
                SubTypeName = s.SubTypeName,
                MachineName = db.Equipments.Where(e => e.Id == s.EquipmentId).Select(e => e.EquipmentId).FirstOrDefault() ?? "",
                UploadStatus = "未上传"
            })
            .OrderBy(s => s.MachineName).ThenBy(s => s.TypeName).ThenBy(s => s.SubTypeName)
            .ToListAsync();

        _materialStatuses.AddRange(subs);
    }

    private void SetMaterialStatus(string matLabel, string status)
    {
        var target = _materialStatuses.FirstOrDefault(s =>
            s.SubTypeName.Contains(matLabel, StringComparison.OrdinalIgnoreCase));
        if (target != null)
            target.UploadStatus = status;
    }

    private void AddLog(string message)
    {
        var line = $"[{DateTime.Now:HH:mm:ss}] {message}";
        _logs.Add(line);
        if (_logs.Count > 500) _logs.RemoveAt(0);
    }

    private static Color GetStatusColor(string status)
    {
        if (status.Contains("成功")) return Color.Success;
        if (status.Contains("未成功") || status.Contains("失败")) return Color.Error;
        if (status.Contains("等待")) return Color.Warning;
        return Color.Default;
    }

    private static string GetStatusIcon(string status)
    {
        if (status.Contains("成功")) return Icons.Material.Filled.CheckCircle;
        if (status.Contains("未成功") || status.Contains("失败")) return Icons.Material.Filled.Error;
        if (status.Contains("等待")) return Icons.Material.Filled.HourglassTop;
        return Icons.Material.Filled.RadioButtonUnchecked;
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
            await _hubConnection.DisposeAsync();
    }
}
