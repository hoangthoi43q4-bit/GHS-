<Window x:Class="GHPHandShake.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GHP HandShake Assistant" Height="680" Width="1080" Background="#F4F7FB">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="10" BorderBrush="#D8DFEA" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="发送Mat_Label：" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="InputTextBox"
                         Grid.Column="1"
                         Margin="0,0,8,0"
                         FontSize="14"
                         KeyDown="InputTextBox_KeyDown" />
                <TextBlock Grid.Column="2" Text="当前项目：" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                <ComboBox x:Name="ProjectComboBox"
                          Grid.Column="3"
                          VerticalAlignment="Center"
                          MinWidth="220"
                          DisplayMemberPath="."
                          SelectionChanged="ProjectComboBox_SelectionChanged"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#D8DFEA" BorderThickness="1" Padding="8" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="通信日志" FontWeight="SemiBold" Margin="4"/>
                    <ListBox x:Name="MessageListBox"
                             Grid.Row="1"
                             Margin="4"
                             FontSize="13"
                             Background="#F7F9FC" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="#D8DFEA" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="项目挂载物料与上传状态" FontWeight="SemiBold" Margin="4"/>
                    <DataGrid x:Name="ProjectMaterialsGrid"
                              Grid.Row="1"
                              Margin="4"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeName}" Width="*"/>
                            <DataGridTextColumn Header="子类型/物料" Binding="{Binding SubTypeName}" Width="1.4*"/>
                            <DataGridTextColumn Header="设备" Binding="{Binding MachineName}" Width="*"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding UploadStatus}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Release Info"
                    Padding="10,6"
                    Margin="0,0,6,0"
                    Click="ReleaseInfoButton_Click"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="物料配置"
                        Padding="10,6"
                        Margin="6,0"
                        Click="MaterialSettingsButton_Click" />
                <Button Content="设置"
                        Padding="10,6"
                        Margin="6,0"
                        Click="SettingsButton_Click" />
                <Button Content="发送"
                        Padding="12,6"
                        Margin="6,0"
                        Click="SendButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>


