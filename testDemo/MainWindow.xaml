<Window x:Class="GHPHandShake.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GHP HandShake Assistant" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="发送Mat_Label：" VerticalAlignment="Center" Margin="15,0,-15,0"/>
        <!-- 输入框 -->
        <TextBox x:Name="InputTextBox" 
                 Grid.Row="0" 
                 Margin="98,10,10,10" 
                 FontSize="14" 
                 KeyDown="InputTextBox_KeyDown" />

        <!-- 消息列表 -->
        
        <ListBox x:Name="MessageListBox" 
                 Grid.Row="1" 
                 Margin="98,46,10,10" 
                 FontSize="14" 
                 Background="#F5F5F5" />
        
        <!-- 按钮面板 -->
        <StackPanel Orientation="Horizontal" 
                    Grid.Row="2" 
                    Margin="10" 
                    HorizontalAlignment="Right">
            <Button Content="物料配置" 
                    Padding="10" 
                    Margin="5,0,5,0" 
                    Click="MaterialSettingsButton_Click" />

            <Button Content="设置" 
                    Padding="10" 
                    Margin="5,0,5,0" 
                    Click="SettingsButton_Click" />
            <Button Content="发送" 
                    Padding="10" 
                    Click="SendButton_Click" />
        </StackPanel>
    </Grid>
</Window>


