<Window x:Class="GHPHandShake.Windows.MaterialUploadHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史物料信息" Height="720" Width="1000" Background="#F4F7FB">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.6*"/>
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="8" BorderBrush="#D8DFEA" BorderThickness="1" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="筛选项目：" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox x:Name="ProjectFilterComboBox"
                          Width="220"
                          Margin="8,0,0,0"
                          SelectionChanged="ProjectFilterComboBox_SelectionChanged"/>
                <Button Content="刷新"
                        Margin="12,0,0,0"
                        Padding="12,6"
                        Click="RefreshButton_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Background="White"
                CornerRadius="8"
                BorderBrush="#D8DFEA"
                BorderThickness="1"
                Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="上料摘要（按 项目 / Pos / 物料号）"
                           FontWeight="SemiBold"
                           Margin="4,0,4,8"
                           FontSize="14"/>
                <DataGrid x:Name="HistoryGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowBackground="White"
                          AlternatingRowBackground="#F8FAFC"
                          SelectionMode="Single"
                          SelectionChanged="HistoryGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="项目" Binding="{Binding ProjectName}" Width="90"/>
                        <DataGridTextColumn Header="Pos(类型)" Binding="{Binding TypeName}" Width="70"/>
                        <DataGridTextColumn Header="物料号" Binding="{Binding SubTypeName}" Width="120"/>
                        <DataGridTextColumn Header="设备" Binding="{Binding MachineName}" Width="110"/>
                        <DataGridTextColumn Header="最近SU（摘要）" Binding="{Binding LatestScanPreview}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding LatestScanContent}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="成功次数" Binding="{Binding UploadCount}" Width="70"/>
                        <DataGridTextColumn Header="最后时间" Binding="{Binding LastTime}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,6">
            <TextBlock x:Name="DetailTitleText"
                       Text="上料明细（请选择上方记录）"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       FontSize="14"/>
            <Button Content="复制选中SU"
                    Margin="16,0,8,0"
                    Padding="10,5"
                    Click="CopySelectedDetail_Click"/>
            <Button Content="复制全部明细"
                    Padding="10,5"
                    Click="CopyAllDetails_Click"/>
            <Button Content="复制最近SU"
                    Margin="8,0,0,0"
                    Padding="10,5"
                    Click="CopyLatestSu_Click"/>
        </StackPanel>

        <Border Grid.Row="3"
                Background="White"
                CornerRadius="8"
                BorderBrush="#D8DFEA"
                BorderThickness="1"
                Padding="8">
            <DataGrid x:Name="DetailGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowBackground="White"
                      AlternatingRowBackground="#F8FAFC"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40"/>
                    <DataGridTextColumn Header="时间" Binding="{Binding Timestamp}" Width="150"/>
                    <DataGridTextColumn Header="结果" Binding="{Binding ResultText}" Width="80"/>
                    <DataGridTextColumn Header="SU（扫码内容）" Binding="{Binding ScanContent}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="6,4"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
