<Window x:Class="GHPHandShake.Windows.MaterialUploadHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史物料信息" Height="600" Width="1100" Background="#F4F7FB">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="8" BorderBrush="#D8DFEA" BorderThickness="1" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="筛选项目：" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox x:Name="ProjectFilterComboBox"
                          Width="220"
                          Margin="8,0,0,0"
                          SelectionChanged="ProjectFilterComboBox_SelectionChanged"/>
                <Button Content="刷新"
                        Margin="12,0,0,0"
                        Padding="12,6"
                        Click="RefreshButton_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Background="White"
                CornerRadius="8"
                BorderBrush="#D8DFEA"
                BorderThickness="1"
                Padding="8">
            <DataGrid x:Name="HistoryGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowBackground="White"
                      AlternatingRowBackground="#F8FAFC"
                      EnableRowVirtualization="False"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      LoadingRow="HistoryGrid_LoadingRow">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="Auto"/>
                        <Setter Property="MinHeight" Value="32"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="项目" Binding="{Binding ProjectName}" Width="90"/>
                    <DataGridTextColumn Header="Pos(类型)" Binding="{Binding TypeName}" Width="70"/>
                    <DataGridTextColumn Header="物料号" Binding="{Binding SubTypeName}" Width="120"/>
                    <DataGridTextColumn Header="设备" Binding="{Binding MachineName}" Width="110"/>
                    <DataGridTemplateColumn Header="SU上料链（扫码内容）" Width="*" MinWidth="360">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding SuChain, Mode=OneWay}"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Disabled"
                                         HorizontalScrollBarVisibility="Disabled"
                                         Margin="4,2"
                                         Padding="2"
                                         ToolTip="{Binding SuChain}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="成功次数" Binding="{Binding UploadCount}" Width="70"/>
                    <DataGridTextColumn Header="最后时间" Binding="{Binding LastTime}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
