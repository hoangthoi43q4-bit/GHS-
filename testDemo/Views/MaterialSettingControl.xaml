<UserControl  x:Class="GHPHandShake.Views.MaterialSettingControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GHPHandShake.Models"
        Height="auto" Width="600">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFCFF"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFCFF"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="项目与类型管理 / 外部导入" Grid.Row="0" Padding="8" Margin="0,0,0,2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,6">
                    <TextBlock Text="项目名：" VerticalAlignment="Center"/>
                    <TextBox x:Name="ProjectNameBox" Width="140" Margin="6,0,6,0"/>
                    <Button Content="添加项目" Click="AddProject_Click" Width="90" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock Text="所属项目：" VerticalAlignment="Center"/>
                    <ComboBox x:Name="TypeProjectComboBox" Width="140" Margin="6,0"/>
                    <TextBlock Text="类型名：" VerticalAlignment="Center"/>
                    <TextBox x:Name="TypeNameBox" Width="120" Margin="6,0"/>
                    <Button Content="添加类型" Click="AddType_Click" Width="90" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="从 Excel 导入" Click="ImportExcel_Click" Width="110" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        
        <GroupBox Header="添加子类型 (Position)" Grid.Row="1" Margin="0,10,0,0" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="所属项目：" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="ParentProjectComboBox"
                          Grid.Row="0"
                          Grid.Column="1"
                          Width="180"
                          SelectionChanged="ParentProjectComboBox_SelectionChanged"/>

                <TextBlock Text="所属类型：" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <ComboBox x:Name="ParentTypeComboBox" Grid.Row="0" Grid.Column="3" Width="180" DisplayMemberPath="TypeName"/>

                <TextBlock Text="子类名 (物料号)：" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,5,0"/>
                <TextBox x:Name="SubTypeNameBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,5,0,0"/>

                <TextBlock Text="关联设备：" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,5,0"/>
                <ComboBox x:Name="MachineComboBox" Grid.Row="2" Grid.Column="1" Margin="0,5,0,0"
          DisplayMemberPath="EquipmentId"/>

                <Button Content="添加子类" Grid.Row="2" Grid.Column="3" Click="AddSubType_Click" Margin="10,5,0,0" Width="100" Style="{StaticResource PrimaryButtonStyle}"/>
            </Grid>
            
        </GroupBox>

        <Border Grid.Row="2" Margin="0,10" BorderBrush="#D8DFEA" BorderThickness="1" CornerRadius="8" Background="#F8FAFC" Padding="6">
            <TreeView x:Name="MaterialTreeView" Background="#F8FAFC" BorderThickness="0">
            <TreeView.Resources>
                <DataTemplate  DataType="{x:Type local:MaterialSubType}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="子类型/物料: "/>
                        <TextBlock Text="{Binding SubTypeName}" FontWeight="SemiBold"/>
                        <TextBlock Text=" -> 关联设备: " Margin="15,0,0,0"/>
                        <TextBlock Text="{Binding AssociatedMachineName}" Foreground="Blue"/>
                    </StackPanel>
                </DataTemplate>

                <HierarchicalDataTemplate DataType="{x:Type local:MaterialProjectNode}" ItemsSource="{Binding Types}">
                    <TextBlock Text="{Binding ProjectName}" FontWeight="Bold" FontSize="14" Foreground="#2c3e50"/>
                </HierarchicalDataTemplate>

                <HierarchicalDataTemplate DataType="{x:Type local:MaterialType}" ItemsSource="{Binding SubTypes}">
                    <TextBlock Text="{Binding TypeName}" FontWeight="SemiBold" FontSize="13"/>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
            </TreeView>
        </Border>

        <Button Grid.Row="3" Content="删除选中项" HorizontalAlignment="Right" Width="100" Click="DeleteItem_Click" Style="{StaticResource SecondaryButtonStyle}"/>
    </Grid>
</UserControl>
